# ==============================================================================
# LineagIQ Server Environment Configuration
# Copy this file to /opt/lineagiq/.env on the server
# ==============================================================================

# Data lake storage path for local single-server deployment
DATA_PATH=/data/tenants/default/

# Optional: LLM Providers for LineagIQ AI Lineage Assistant
OPENAI_API_KEY=
GEMINI_API_KEY=

# Domains
DOMAIN_NAME=lineagiq.com
PLANE_DOMAIN=plane.lineagiq.com
ADMIN_EMAIL=admin@lineagiq.com
